---
import Bars from "./Bars.astro";
import { buy } from "../sample";

import svgUnderline from "../assets/underline.svg";
import arrowCard from "../assets/arrow-card.svg";

const categorias = [
    {
        nombre: "Modelado",
        url: "/modelado",
        image: "https://i.pinimg.com/1200x/8e/cc/8c/8ecc8cf4239853b59e9a52afa95d86ad.jpg",
        descripcion:
            "El modelado de datos es el proceso de crear una representación ...",
    },
    {
        nombre: "Normalización",
        url: "/normalizacion",
        image: "https://blog.invgate.com/hubfs/normalizacion-de-base-de-datos.png",
        descripcion:
            "La normalización de bases de datos es un proceso de diseño de ...",
    },
    {
        nombre: "Lenguaje de consulta estructurado (SQL)",
        url: "/sql",
        image: "https://i.pinimg.com/736x/14/20/fd/1420fdb2c1b84a55bc9a61e3050b0fa5.jpg",
        descripcion:
            "El lenguaje de consulta estructurado (SQL) es un lenguaje de ...",
    },
    {
        nombre: "Proyecto",
        url: "/proyecto",
        image: "https://i.pinimg.com/736x/93/83/59/938359e19ab1532ba2b52e8e3d4820e3.jpg",
        descripcion: "Proyecto final integrador...",
    },
];
---

<section class="py-25 space-y-10 px-5" id="work">
    <div class="max-w-md mx-auto relative">
        <h1 class="text-4xl font-medium text-center">Evidencias</h1>
        <img
            src={svgUnderline.src}
            alt="arrow"
            width="140"
            class="absolute left-45 -bottom-1"
        />
    </div>

    <div class="max-w-3xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-10">
        {
            categorias.map((item) => (
                <a
                    href={item.url}
                    target="_blank"
                    class="flex flex-col bg-white p-5 group relative transition-all duration-200 hover:shadow-[4px_4px_0px_rgba(0,0,0,0.3)]"
                >
                    <div class="w-full h-[200px] overflow-hidden border-2">
                        <img
                            src={item.image}
                            alt=""
                            class="w-full h-full object-cover"
                        />
                    </div>
                    <div class="space-y-1 pt-4">
                        <div class="flex pr-2">
                            <h2 class="text-xl font-medium flex-1">
                                {item.nombre}
                            </h2>
                            <img src={arrowCard.src} alt="arrow" width="25" />
                        </div>
                        <p class="mr-20">{item.descripcion}</p>
                    </div>
                    <Bars />
                </a>
            ))
        }
    </div>
</section>
